---
interface Props {
  id: string;
  index: string;
  title: string;
  lead?: string;
  divider?: boolean;
}

const { id, index, title, lead, divider = true } = Astro.props;
---

<section id={id} class="scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <header class="reveal mb-12 sm:mb-16">
      <div class="flex items-center gap-3">
        <span class="eyebrow text-accent">{index}</span>
        <span class="h-px w-10 bg-line-strong" aria-hidden="true"></span>
        <span class="eyebrow">{title}</span>
      </div>
      <slot name="heading" />
      {
        lead && (
          <p class="mt-5 max-w-2xl text-[15px] leading-relaxed text-muted sm:text-base">{lead}</p>
        )
      }
    </header>

    <slot />
  </div>

  {
    divider && (
      <div class="mx-auto mt-20 max-w-6xl px-5 sm:px-8 sm:mt-28">
        <div class="h-px w-full bg-line" />
      </div>
    )
  }
</section>
