---
import { nav, person } from '../data/site';
---

<div
  id="scroll-progress"
  class="fixed left-0 top-0 z-[60] h-[2px] w-full origin-left scale-x-0 bg-accent"
  aria-hidden="true"
>
</div>

<header
  id="site-nav"
  class="fixed inset-x-0 top-0 z-50 transition-[background-color,border-color,backdrop-filter] duration-500"
  data-nav
>
  <nav
    aria-label="Primary"
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-5 py-4 sm:px-8"
  >
    <a
      href="#top"
      class="group flex items-center gap-2.5 text-sm font-medium tracking-tight"
      aria-label={`${person.name} — back to top`}
    >
      <span
        class="grid h-8 w-8 place-items-center rounded-lg border border-line bg-surface font-mono text-[11px] font-semibold text-accent transition-transform duration-500 group-hover:rotate-[-8deg] group-hover:scale-105"
        aria-hidden="true">AS</span
      >
      <span class="hidden sm:inline">{person.name}</span>
    </a>

    <ul class="hidden items-center gap-1 md:flex">
      {
        nav.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              data-navlink={item.id}
              class="group relative flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-[13px] text-muted transition-colors duration-300 hover:text-text"
            >
              <span class="font-mono text-[10px] text-faint transition-colors group-hover:text-accent">
                {item.index}
              </span>
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <button
        type="button"
        data-theme-toggle
        class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-surface text-muted transition-colors duration-300 hover:border-line-strong hover:text-text"
        aria-label="Toggle colour theme"
      >
        <svg class="h-4 w-4" data-icon-sun viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4"></path>
        </svg>
        <svg class="hidden h-4 w-4" data-icon-moon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
        </svg>
      </button>

      <a
        href={person.resumePath}
        download
        class="hidden rounded-lg border border-line bg-surface px-3.5 py-2 text-[13px] font-medium text-text transition-all duration-300 hover:border-accent hover:text-accent-text sm:block"
      >
        Résumé
      </a>

      <button
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-9 w-9 place-items-center rounded-lg border border-line bg-surface text-text md:hidden"
        aria-label="Open menu"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </nav>

  <div
    id="mobile-menu"
    hidden
    class="border-t border-line bg-bg-elev/95 backdrop-blur-xl md:hidden"
  >
    <ul class="mx-auto max-w-6xl px-5 py-3 sm:px-8">
      {
        nav.map((item) => (
          <li class="border-b border-line/60 last:border-0">
            <a
              href={`#${item.id}`}
              data-mobile-link
              class="flex items-center gap-3 py-3 text-sm text-muted transition-colors hover:text-text"
            >
              <span class="font-mono text-[10px] text-faint">{item.index}</span>
              {item.label}
            </a>
          </li>
        ))
      }
      <li class="pt-3">
        <a
          href={person.resumePath}
          download
          class="block rounded-lg border border-line bg-surface px-4 py-2.5 text-center text-sm font-medium"
        >
          Download résumé
        </a>
      </li>
    </ul>
  </div>
</header>
