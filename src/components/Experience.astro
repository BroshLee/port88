---
import Section from './Section.astro';
import { experience } from '../data/site';
---

<Section
  id="experience"
  index="03"
  title="Experience"
  lead="Three teams, three very different codebases — and a steady move from full-stack product work toward backend systems and infrastructure."
>
  <h2 slot="heading" class="display-sm mt-5 max-w-3xl">
    Where I've <em class="text-accent">shipped</em>.
  </h2>

  <div class="relative" data-timeline>
    {/* Rail that fills as the section scrolls past */}
    <div
      class="absolute left-[7px] top-2 hidden h-full w-px bg-line sm:block"
      aria-hidden="true"
    >
      <div
        class="h-full w-full origin-top scale-y-0 bg-accent"
        data-timeline-fill
      >
      </div>
    </div>

    <ol class="space-y-4 sm:space-y-5 sm:pl-12">
      {
        experience.map((job) => (
          <li class="reveal relative">
            <span
              class="absolute -left-12 top-7 hidden h-[15px] w-[15px] items-center justify-center rounded-full border border-line bg-bg sm:flex"
              aria-hidden="true"
            >
              <span
                class={`h-[7px] w-[7px] rounded-full ${job.current ? 'bg-accent dot-pulse' : 'bg-line-strong'}`}
              />
            </span>

            <article class="card tilt relative p-6 sm:p-8" data-tilt="3.5">
              <div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-3">
                <div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <h3 class="text-lg font-semibold tracking-tight text-text sm:text-xl">
                      {job.company}
                    </h3>
                    {job.current && (
                      <span class="rounded-full border border-accent/40 bg-accent-weak px-2.5 py-0.5 font-mono text-[10px] uppercase tracking-wider text-accent-text">
                        Current
                      </span>
                    )}
                  </div>
                  <p class="mt-1 text-[14px] text-muted">
                    {job.role} · {job.location}
                  </p>
                </div>
                <time class="mono-xs shrink-0 text-faint">{job.period}</time>
              </div>

              <p class="mt-5 max-w-2xl text-[14.5px] leading-relaxed text-text/85">{job.summary}</p>

              <ul class="mt-6 space-y-3">
                {job.bullets.map((b) => (
                  <li class="flex gap-3 text-[14px] leading-relaxed text-muted">
                    <span class="mt-[9px] h-[3px] w-[3px] shrink-0 rounded-full bg-accent" aria-hidden="true" />
                    <span>{b}</span>
                  </li>
                ))}
              </ul>

              <ul class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
                {job.stack.map((s) => (
                  <li>
                    <span class="chip">{s}</span>
                  </li>
                ))}
              </ul>
            </article>
          </li>
        ))
      }
    </ol>
  </div>
</Section>
