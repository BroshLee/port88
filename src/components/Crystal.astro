---
// Three snowflake planes intersecting at 60° in 3D space, spinning as one solid.
interface Props {
  class?: string;
  size?: string;
}
const { class: className = '', size = '190px' } = Astro.props;

const arms = [0, 60, 120, 180, 240, 300];
const planes = [0, 60, 120];
---

<div class={`crystal-wrap scene ${className}`} style={`--size:${size}`} aria-hidden="true">
  <div class="crystal preserve-3d">
    {
      planes.map((angle) => (
        <svg class="crystal-plane" viewBox="0 0 100 100" style={`--ry:${angle}deg`}>
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            transform="translate(50 50)"
          >
            {arms.map((a) => (
              <g transform={`rotate(${a})`}>
                <line x1="0" y1="0" x2="0" y2="-40" />
                <line x1="0" y1="-16" x2="-9" y2="-25" />
                <line x1="0" y1="-16" x2="9" y2="-25" />
                <line x1="0" y1="-28" x2="-6.5" y2="-34.5" />
                <line x1="0" y1="-28" x2="6.5" y2="-34.5" />
              </g>
            ))}
            <circle r="3.4" fill="currentColor" stroke="none" opacity="0.7" />
          </g>
        </svg>
      ))
    }
  </div>
</div>

<style>
  .crystal-wrap {
    width: var(--size);
    height: var(--size);
    --perspective: 700px;
    color: var(--accent);
    animation: float-y 9s ease-in-out infinite;
  }

  .crystal {
    position: relative;
    width: 100%;
    height: 100%;
    animation: crystal-spin 26s linear infinite;
  }

  .crystal-plane {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transform: rotateY(var(--ry));
    opacity: 0.62;
    filter: drop-shadow(0 0 10px var(--glow));
  }

  /* The face-on plane reads as the "front" of the crystal. */
  .crystal-plane:first-child {
    opacity: 0.9;
  }

  @media (prefers-reduced-motion: reduce) {
    .crystal-wrap,
    .crystal {
      animation: none;
    }
    .crystal {
      transform: rotateX(-16deg) rotateY(18deg);
    }
  }
</style>
