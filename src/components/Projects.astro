---
import Section from './Section.astro';
import { projects } from '../data/site';

const blocks = [
  { key: 'problem' as const, label: 'Problem' },
  { key: 'approach' as const, label: 'Approach' },
  { key: 'outcome' as const, label: 'Outcome' },
];
---

<Section
  id="work"
  index="04"
  title="Selected work"
  lead="Written as problem, approach and outcome — the parts of a project that actually tell you how someone thinks."
>
  <h2 slot="heading" class="display-sm mt-5 max-w-3xl">
    Things I've <em class="text-accent">built</em>.
  </h2>

  <div class="grid gap-5 lg:grid-cols-2">
    {
      // reveal and tilt must live on separate elements — both animate
      // `transform`, and the reveal's rule would win and kill the tilt.
      projects.map((p, i) => (
        <div class="reveal-3d h-full" style={`--reveal-delay:${(i % 2) * 90}ms`}>
          <article
            class="spotlight tilt group relative h-full rounded-2xl border border-line bg-bg-elev p-6 transition-[border-color] duration-500 hover:border-line-strong sm:p-8"
            data-tilt="6"
          >
            <div class="tilt-lift relative z-10" style="--lift:34px">
            <div class="flex items-start justify-between gap-4">
              <span class="mono-xs text-faint">{String(i + 1).padStart(2, '0')}</span>
              <span class="rounded-full border border-line bg-surface px-2.5 py-1 font-mono text-[10px] uppercase tracking-wider text-faint">
                {p.kind}
              </span>
            </div>

            <h3 class="mt-5 text-xl font-semibold tracking-tight text-text sm:text-[1.375rem]">
              {p.title}
            </h3>
            <p class="mt-1.5 text-[13.5px] text-accent-text">{p.tagline}</p>

            <dl class="mt-6 space-y-4">
              {blocks.map((b) => (
                <div class="border-l border-line pl-4 transition-colors duration-500 group-hover:border-accent/40">
                  <dt class="eyebrow mb-1.5">{b.label}</dt>
                  <dd class="text-[13.5px] leading-relaxed text-muted">{p[b.key]}</dd>
                </div>
              ))}
            </dl>

            <ul class="mt-6 flex flex-wrap gap-2 border-t border-line pt-5">
              {p.stack.map((s) => (
                <li>
                  <span class="chip">{s}</span>
                </li>
              ))}
            </ul>

            {p.links && p.links.length > 0 && (
              <div class="mt-5 flex flex-wrap gap-4">
                {p.links.map((l) => (
                  <a
                    href={l.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link-wipe text-[13px] font-medium text-text"
                  >
                    {l.label} ↗
                  </a>
                ))}
              </div>
            )}
            </div>
          </article>
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* Cursor-tracked highlight; --mx/--my are written by the tilt script. */
  .spotlight::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s var(--ease-out-expo);
    background: radial-gradient(
      420px circle at var(--mx, 50%) var(--my, 50%),
      var(--accent-weak),
      transparent 70%
    );
    pointer-events: none;
  }

  .spotlight:hover::before,
  .spotlight:focus-within::before {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .spotlight::before {
      display: none;
    }
  }
</style>
